# OpenRouter APIキー（必須）。サーバー側だけが持ち、ブラウザには渡さない
OPENROUTER_API_KEY=

# 公開VPSでは必須。未設定だと認証が無効（開発用）
APP_PASSWORD=

# ログインパスワードの比較に使うHMAC鍵（ランダムな長い文字列）。未設定なら APP_PASSWORD を代用
SESSION_SECRET=

# 会話用の既定モデル。画面（設定）で選んだ値があればそちらが優先される
DEFAULT_MODEL=~anthropic/claude-sonnet-latest
# 記憶の要約用。空なら会話用と同じモデルを使う
UTILITY_MODEL=

# 同じVPSの aI-chatv2（3001）・Novel（3000）と重ならない番号にする
PORT=3002
# Tailscale の背後に置くなら 127.0.0.1（VPSでは最初からこれでよい。行頭の # を消して有効にする）
# BIND=127.0.0.1
DB_PATH=./data/app.sqlite
APP_URL=http://localhost:3002
APP_TITLE=Language Partner

# 認証Cookieに secure を付けるか。未設定なら APP_URL が https:// のときだけ有効
# COOKIE_SECURE=1
# リバースプロキシ（tailscale serve 含む）の背後なら 1
# TRUST_PROXY=1

# 1回の生成の待ち時間の上限（ミリ秒）
# LLM_TIMEOUT_MS=90000

# LLMのエンドポイント。テストでモックに向ける場合のみ設定する
# OPENROUTER_BASE_URL=http://localhost:4020/v1
